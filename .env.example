# Copy to web/.env.local

# --- İletişim formu (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_INBOX_TO=

# --- Harita (/contact) — zorunlu; prod public token repoda tutulmuyor ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- YST AI (isteğe bağlı; boş bırakılırsa prod gibi yapılandırılmamış mesajı) ---
NEXT_PUBLIC_OPENAI_API_KEY=
